# Clave de AssemblyAI: el reconocedor y el modelo de lenguaje, por el LLM Gateway.
# El reconocimiento sale del crédito gratuito; el gateway exige pago por uso.
ASSEMBLYAI_API_KEY=

# Clave de Cartesia: la voz de Vera. Tiene plan gratuito.
CARTESIA_API_KEY=

# Guarda cada turno cerrado (texto y señales del motor) en registros/, fuera del
# repo. Sirve para medir con habla real qué le hace el reconocedor al paciente.
# REGISTRO_TURNOS=true
